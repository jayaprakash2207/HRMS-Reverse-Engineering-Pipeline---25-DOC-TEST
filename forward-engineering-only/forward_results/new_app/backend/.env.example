# Copy to .env (gitignored) and fill in real values for local development.
# This sprint (Security/Identity) introduced these variables; there are no
# hard-coded fallback values for secrets, by design (see STACK_MAPPING_CONTRACT.md).

# JWT signing secret - base64-encoded, must decode to >= 256 bits.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional overrides (defaults shown; in seconds)
# JWT_ACCESS_TOKEN_TTL_SECONDS=900
# JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# Base64-encoded 256-bit AES key backing EncryptedStringConverter, used by any
# entity that later applies @Convert(converter = EncryptedStringConverter.class)
# (e.g. the Employee Management context's SSN column). The env var name is derived
# from app.security.encryption.key-secret-name (default "hrms/pii-encryption-key"
# -> HRMS_PII_ENCRYPTION_KEY). Not required to run this sprint's auth endpoints.
# Generate with: openssl rand -base64 32
HRMS_PII_ENCRYPTION_KEY=
