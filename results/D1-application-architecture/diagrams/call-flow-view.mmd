sequenceDiagram
    participant F as HRMS_LOGIN.fmb
    participant SEC as PKG_SECURITY
    participant MENU as HRMS_MENU.fmb
    participant EMP as HRMS_EMPLOYEE.fmb
    participant PKG_EMP as PKG_EMPLOYEE
    participant PKG_PAY as PKG_PAYROLL
    participant PKG_AUD as PKG_AUDIT
    participant PKG_NOT as PKG_NOTIFICATION
    participant Q as NOTIFICATION_QUEUE
    participant SMTP as UTL_SMTP

    note over F,SMTP: Flow 1 — User Login
    F->>SEC: authenticate(email, password)
    note right of SEC: ⚠ Password check NOT implemented
    SEC-->>F: session_id, emp_id
    F->>F: SET GLOBAL.session_id / current_user / current_emp_id
    F->>MENU: OPEN_FORM('HRMS_MENU')
    MENU->>SEC: has_permission(session_id, 'PAYROLL', 'VIEW')
    SEC-->>MENU: TRUE/FALSE
    MENU->>MENU: SETPROPERTY menu items enabled/disabled

    note over EMP,PKG_NOT: Flow 2 — Hire New Employee
    EMP->>EMP: PRE-INSERT: fetch SEQ_EMPLOYEE.NEXTVAL
    EMP->>PKG_EMP: generate_emp_number()
    note right of PKG_EMP: ⚠ Race condition — no SELECT FOR UPDATE
    PKG_EMP-->>EMP: emp_number
    EMP->>PKG_EMP: create_employee(...)
    PKG_EMP->>PKG_PAY: create_salary_record(emp_id, salary)
    note right of PKG_PAY: Circular dependency
    PKG_PAY-->>PKG_EMP: OK
    PKG_EMP->>PKG_AUD: log_action('EMPLOYEE','INSERT',emp_id)
    note right of PKG_AUD: AUTONOMOUS_TRANSACTION
    PKG_AUD-->>PKG_EMP: OK
    PKG_EMP->>PKG_NOT: send_notification('WELCOME', emp_id)
    note right of PKG_NOT: AUTONOMOUS_TRANSACTION — queues to NOTIFICATION_QUEUE
    PKG_NOT->>Q: INSERT (STATUS=PENDING)
    PKG_NOT-->>PKG_EMP: OK (never fails)
    PKG_EMP->>PKG_NOT: send_notification('HR_ALERT', ...)
    PKG_NOT->>Q: INSERT (STATUS=PENDING)

    note over Q,SMTP: Flow 3 — Process Notification Queue (every 5 min)
    Q->>PKG_NOT: DBMS_SCHEDULER triggers process_queue
    loop For each PENDING notification (max 50)
        PKG_NOT->>SMTP: UTL_SMTP.open_connection (new per email ⚠)
        PKG_NOT->>SMTP: UTL_SMTP.write_data / RCPT_TO / MAIL_FROM
        SMTP-->>PKG_NOT: OK or error
        PKG_NOT->>Q: UPDATE STATUS = SENT (or FAILED + increment RETRY_COUNT)
    end
