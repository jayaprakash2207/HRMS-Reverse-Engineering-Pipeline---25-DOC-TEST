C4Component
    title Component View — Oracle HRMS PL/SQL Package Layer

    Container_Boundary(db, "Oracle Database — Schema HRMS") {

        Component(pkg_security, "PKG_SECURITY", "PL/SQL Package", "Authentication, session management, SSN encryption, permission checks. CRITICAL BUGS: auth not implemented, hard-coded key, MD5.")
        Component(pkg_employee, "PKG_EMPLOYEE", "PL/SQL Package", "Employee CRUD, search (SQL injection risk), transfer, termination, org chart. Circular dep with PKG_PAYROLL.")
        Component(pkg_payroll, "PKG_PAYROLL", "PL/SQL Package", "Payroll run lifecycle, tax calculation (2024 rates hard-coded), pay register export. YTD=0 bug. Circular dep with PKG_EMPLOYEE.")
        Component(pkg_leave, "PKG_LEAVE", "PL/SQL Package", "Leave request submit/approve/reject/cancel, balance calculation, monthly accrual batch, carryover processing.")
        Component(pkg_performance, "PKG_PERFORMANCE", "PL/SQL Package", "Review cycle management, self-assessment, manager review, goal tracking.")
        Component(pkg_notification, "PKG_NOTIFICATION", "PL/SQL Package", "Async notification queue, SMTP dispatch (UTL_SMTP), retry logic. AUTONOMOUS_TRANSACTION.")
        Component(pkg_integration, "PKG_INTEGRATION", "PL/SQL Package", "GL journal feed (UTL_FILE), ADP benefits export (UTL_FILE). T&A import: NOT IMPLEMENTED. FTP credentials in cleartext.")
        Component(pkg_reporting, "PKG_REPORTING", "PL/SQL Package", "8 REF CURSOR reports. refresh_reporting_tables: PLACEHOLDER.")
        Component(pkg_audit, "PKG_AUDIT", "PL/SQL Package", "Audit log writes (AUTONOMOUS_TRANSACTION), purge, history query.")
        Component(pkg_common, "PKG_COMMON", "PL/SQL Package", "Error/info logging, system parameters, date utilities, formatters, validators.")
        Component(pkg_validation, "PKG_VALIDATION", "PL/SQL Package", "Salary-for-grade validation, business-day checks. Delegates to PKG_COMMON and direct DB queries.")

        Component(triggers, "DB Triggers (6)", "Oracle Triggers", "TRG_EMP_BEFORE_INSERT/UPDATE, TRG_EMP_INSTEAD_OF_DELETE (soft-delete enforcer), TRG_SALARY_AUDIT, TRG_LEAVE_REQUEST_AUDIT, TRG_DEPARTMENT_AUDIT.")
        Component(views, "Views (6)", "Oracle Views", "VW_ACTIVE_EMPLOYEES, VW_ORG_HIERARCHY (CONNECT BY), VW_EMPLOYEE_COMPENSATION, VW_LEAVE_SUMMARY, VW_PAYROLL_LATEST, VW_PENDING_APPROVALS.")
    }

    Rel(pkg_employee, pkg_payroll, "calls create_salary_record", "circular dependency")
    Rel(pkg_payroll, pkg_employee, "calls employee lookup", "circular dependency")
    Rel(pkg_employee, pkg_audit, "calls log_action")
    Rel(pkg_employee, pkg_notification, "calls send_notification")
    Rel(pkg_leave, pkg_notification, "calls send_notification")
    Rel(pkg_performance, pkg_notification, "calls send_notification")
    Rel(pkg_payroll, pkg_notification, "calls send_notification")
    Rel(pkg_employee, pkg_common, "uses utilities")
    Rel(pkg_payroll, pkg_common, "uses utilities")
    Rel(pkg_leave, pkg_common, "uses utilities")
    Rel(pkg_security, pkg_common, "uses log_error")
    Rel(pkg_validation, pkg_common, "delegates validation")
    Rel(pkg_integration, pkg_common, "uses log_error")
    Rel(pkg_reporting, pkg_common, "uses utilities")
    Rel(pkg_notification, pkg_audit, "calls log_action")
    Rel(triggers, pkg_audit, "calls log_action (via AUDIT_LOG insert)")
