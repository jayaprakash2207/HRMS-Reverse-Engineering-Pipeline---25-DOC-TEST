C4Container
    title Container View — Oracle HRMS v4.2

    Person(user, "HRMS User", "HR Admin / Manager / Employee / Payroll Admin")

    System_Boundary(hrms_sys, "Oracle HRMS") {
        Container(forms_runtime, "Oracle Forms Runtime", "Oracle Forms 12c (12.2.1.4)", "Renders Oracle Forms .fmb screens. Hosts 6 forms + 2 PLL libraries + 1 menu module. Connects directly to Oracle DB.")
        Container(oracle_db, "Oracle Database", "Oracle RDBMS — version unknown", "Hosts schema HRMS. Contains all tables, views, sequences, 11 PL/SQL packages, 6 triggers.")
        Container(oracle_dirs, "Oracle Directory Objects", "OS filesystem paths registered as Oracle Directories", "PAYROLL_OUTPUT, GL_FEED_OUT, BENEFITS_FEED_OUT, TIME_ATTENDANCE_IN. Used by UTL_FILE for flat-file I/O.")
    }

    System_Ext(gl, "GL System", "Pipe-delimited flat file consumer")
    System_Ext(adp, "ADP Benefits", "Fixed-width file consumer")
    System_Ext(smtp, "SMTP Server", "Email relay")
    System_Ext(time_sys, "Time & Attendance", "CSV file provider (import unimplemented)")

    Rel(user, forms_runtime, "Interacts via", "Oracle Forms client (thin/web runtime)")
    Rel(forms_runtime, oracle_db, "Reads/writes data", "Oracle Net / SQL*Net — direct DB connection")
    Rel(oracle_db, oracle_dirs, "Reads/writes files", "UTL_FILE (PKG_INTEGRATION, PKG_PAYROLL)")
    Rel(oracle_dirs, gl, "GL journal export", "File pickup / FTP (external process)")
    Rel(oracle_dirs, adp, "Benefits export", "File pickup / FTP (external process)")
    Rel(time_sys, oracle_dirs, "Time data file drop", "FTP (external process — DB read not implemented)")
    Rel(oracle_db, smtp, "Email notifications", "UTL_SMTP plaintext port 25")
